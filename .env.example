# MindBridge configuration. Copy to ".env" (setup.bat does this) and edit.
# Every value is optional - with nothing filled in, MindBridge uses its
# built-in offline conversation engine and works without internet.

# ---- Free LLM for more natural replies (pick one or both) ------------------
# Groq (free tier, very fast): create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini (free tier): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Order: auto = Groq -> Gemini -> Ollama (if running) -> offline engine
# Force one with: groq | gemini | ollama | offline
LLM_PROVIDER=auto

# Model names (comma-separated fallbacks; change if a provider retires one)
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash

# Ollama = free local LLM (https://ollama.com). After installing: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Name of the AI companion (Anvaya = Sanskrit for "connection")
COMPANION_NAME=Anvaya

# Set to 0 on a very low-RAM PC (<4 GB) to skip the three AI models (~2.3 GB RAM)
MINDBRIDGE_ENABLE_MODELS=1
